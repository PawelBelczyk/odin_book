<h1>Odin Book</h1>

<% if user_signed_in? %>
  <p>
    Logged in as: <%= current_user.email %>
  </p>

  <p>
  <%= link_to "My profile", profile_path %>
  </p>
  <p>
  <%= link_to "All users", users_path %>
  </p>

  <%= button_to "Log out", destroy_user_session_path, method: :delete %>
<% end %>

<hr>

<h2>Create post</h2>

<%= form_with model: @post do |form| %>
  <% if @post.errors.any? %>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.text_area :content, placeholder: "Wpisz tu swoją treść" %>
  </div>
<div>
  <%= form.file_field :image %>
</div>

  <div>
    <%= form.submit "Post" %>
  </div>
<% end %>

<hr>

<h2>Posts</h2>

<% @posts.each do |post| %>
  <div>
    <p>
      <strong><%= post.user.email %></strong>
    </p>

    <p>
      <%= post.content %>
    </p>
    <% if post.image.attached? %>
  <%= image_tag post.image, width: 400 %>
<% end %>

    <small>
      <%= post.created_at.strftime("%Y-%m-%d %H:%M") %>
    </small>
    <p>
  Likes: <%= post.likes.count %>
</p>

<% current_like = post.likes.find { |like| like.user_id == current_user.id } %>

<% if current_like %>
  <%= button_to "Unlike", post_like_path(post, current_like), method: :delete %>
<% else %>
  <%= button_to "Like", post_likes_path(post), method: :post %>
<% end %>
    <h4>Comments</h4>
    

<% post.comments.each do |comment| %>
  <div>
    <strong><%= comment.user.email %></strong>
    <p><%= comment.content %></p>
  </div>
<% end %>

<%= form_with model: [post, Comment.new] do |form| %>
  <div>
    <%= form.text_area :content, placeholder: "Write a comment" %>
  </div>

  <div>
    <%= form.submit "Comment" %>
  </div>
<% end %>
  </div>

  <hr>
<% end %>

